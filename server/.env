# MySQL
MYSQL_DATABASE=repoint
MYSQL_USER=repoint_user
MYSQL_PASSWORD=repoint_password
MYSQL_ROOT_PASSWORD=root_password

# Spring Datasource
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/repoint?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=repoint_user
SPRING_DATASOURCE_PASSWORD=repoint_password

# App
SPRING_PROFILES_ACTIVE=docker